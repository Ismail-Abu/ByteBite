<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 auto-backup rules (fullBackupContent). Health data is kept
  local: the meal-history database and any app-owned meal images are excluded
  from OS cloud backup, so a dietary log never leaves the device this way. Only
  the non-health settings (e.g. the theme choice) remain eligible for backup.
  Android 12+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="database" path="bytebite-meals.db"/>
    <exclude domain="database" path="bytebite-meals.db-wal"/>
    <exclude domain="database" path="bytebite-meals.db-shm"/>
    <exclude domain="file" path="meal_images/"/>
</full-backup-content>
