<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. The meal-history database and any app-owned
  meal images are health data and are excluded from BOTH cloud backup and
  device-to-device transfer, so the dietary log stays strictly on this device.
  Non-health settings (the theme choice) are allowed. Platform limitation: this
  means history is not carried to a new device by OS transfer; a dedicated
  user-initiated export/import is a documented future addition.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bytebite-meals.db"/>
        <exclude domain="database" path="bytebite-meals.db-wal"/>
        <exclude domain="database" path="bytebite-meals.db-shm"/>
        <exclude domain="file" path="meal_images/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bytebite-meals.db"/>
        <exclude domain="database" path="bytebite-meals.db-wal"/>
        <exclude domain="database" path="bytebite-meals.db-shm"/>
        <exclude domain="file" path="meal_images/"/>
    </device-transfer>
</data-extraction-rules>
